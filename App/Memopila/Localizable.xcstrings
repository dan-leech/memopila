    },
    "%@: items up to %lld MB": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: элементы до %lld МБ"
          }
        }
      }
    },
    "%@: not recognizing text in images": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: текст на изображениях не распознаётся"
