{
  "sourceLanguage": "en",
  "strings": {
    "%@ Settings…": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройки «%@»…"
          }
        }
      }
    },
    "%@ is already used for %@.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ уже используется для действия «%@»."
          }
        }
      }
    },
    "%@ of %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ из %2$@"
          }
        }
      }
    },
    "%@: applies to %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: применяется к %2$@"
          }
        }
      }
    },
    "%@: applies to the selected text, or to all of it": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: к выделенному тексту или ко всему тексту"
          }
        }
      }
    },
    "%@: delete after %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: удалять через %@"
